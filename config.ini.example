[imap]
server = imap.1blu.de
port = 993
user = your_imap_user
password = your_imap_password
folder_inbox = INBOX
folder_fish = Fish
folder_spam = Spam

[thresholds]
auto_fish = 70
claude_check = 30
spamassassin_spam = 8.0

[claude]
binary = /root/.local/bin/claude
model = sonnet

[spamassassin]
enabled = false
spamc_binary = /usr/bin/spamc
spamassassin_binary = /usr/bin/spamassassin
timeout = 20
max_bytes = 750000
